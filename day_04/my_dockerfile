FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends cowsay && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/games:${PATH}"

ENTRYPOINT ["cowsay"]
CMD ["Moo! Hello from inside a container"]
